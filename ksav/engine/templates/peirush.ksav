#הגדרות_זרמים(פריסה: "צד", זרמים: ("תוכן", "מקורות"), מספור: ("מקורות": "א"), כותרות: ("תוכן": [ביאורים], "מקורות": [מראי מקומות]))

#שער[חידושים על מסכת ברכות]
#תת_שער[ביאורים ומראי מקומות זה לצד זה]

#קו_מפריד

#סימן[א׳][בענין ברכה קודם הנאה]

אָסוּר לוֹ לָאָדָם שֶׁיֵּהָנֶה מִן הָעוֹלָם הַזֶּה בְּלֹא בְּרָכָה#הערת_תוכן[
והטעם, שכל הנהנה בלא ברכה כאילו נהנה מקדשי שמים, שהעולם כולו קדש הוא עד שיתירנו בברכה.
]#הערת_מקור[#ציון_מקור("ברכות", מקום: "ל״ה ע״א").], וְכָל הַנֶּהֱנֶה בְּלֹא בְּרָכָה כְּאִלּוּ מָעַל.

וּמִכָּאן לָמְדוּ שֶׁצָּרִיךְ לְבָרֵךְ סָמוּךְ לַהֲנָאָתוֹ מַמָּשׁ#הערת_תוכן[
״סמוך״ ולא ״לפני״: שיעורו כדי דיבור, ואם שהה יותר חוזר ומברך.
]#הערת_מקור[#ציון_מקור("שולחן ערוך", מקום: "אורח חיים סימן קס״ז"), ובמשנה ברורה שם.], וְלֹא יַפְסִיק בֵּינְתַיִם.

#סימן[ב׳][סדר הקדימה]

הָיוּ לְפָנָיו מִינִים הַרְבֵּה — מַקְדִּים אֶת הֶחָבִיב#הערת_תוכן[
וחביב היינו החביב עליו עתה, ולא החשוב בעצם. ונחלקו בזה הפוסקים.
]#הערת_מקור[#ציון_מקור("ברכות", מקום: "מ׳ ע״ב"), ו#ציון_מקור("שולחן ערוך", מקום: "סימן רי״א").].

#קו_מפריד

