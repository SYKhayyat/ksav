#הגדרות_מדורגות(גודל: (0.9em, 0.85em), מספור: ("א", "1"))

#שער[קונטרס הלכות ברכות]
#תת_שער[בעניני ברכות הנהנין ודיניהן]

#קו_מפריד

#סימן[א׳][דין ברכה קודם הנאה]

#סעיף[א][אָסוּר לוֹ לָאָדָם שֶׁיֵּהָנֶה מִן הָעוֹלָם הַזֶּה בְּלֹא בְּרָכָה, וְכָל הַנֶּהֱנֶה בְּלֹא בְּרָכָה כְּאִלּוּ מָעַל בְּקָדְשֵׁי שָׁמַיִם#מראה_מקום(מקור: "ברכות-לה-א")[#ציון_מקור("ברכות", מקום: "ל״ה ע״א"), ו#ציון_מקור("רמב״ם", מקום: "הלכות ברכות פרק א׳ הלכה ב׳").].]

#סעיף[ב][צָרִיךְ לְבָרֵךְ קֹדֶם שֶׁיֵּהָנֶה סָמוּךְ לַהֲנָאָתוֹ מַמָּשׁ, וְלֹא יַפְסִיק בֵּין הַבְּרָכָה לָאֲכִילָה כְּדֵי דִּבּוּר#מדור_א[
  כן פסק #ציון_מקור("שולחן ערוך", מקום: "אורח חיים סימן קס״ז סעיף ו׳"), וכן במשנה ברורה שם ס״ק מ״ה.#מדור_ב[ויש שדקדקו שאף שיחה בעלמא הפסק היא, ועיין בביאור הלכה שם.]
].]

#סעיף[ג][הַמְבָרֵךְ צָרִיךְ שֶׁיַּשְׁמִיעַ לְאָזְנוֹ מַה שֶּׁמּוֹצִיא בִּשְׂפָתָיו, וְאִם לֹא הִשְׁמִיעַ לְאָזְנוֹ יָצָא, וּבִלְבַד שֶׁיּוֹצִיא בִּשְׂפָתָיו#מדור_א[#ציון_מקור("שולחן ערוך", מקום: "סימן ר״ו סעיף ג׳").].]

#הערות_מדורגות(כותרת: [ביאורים])

#סימן[ב׳][סדר קדימה בברכות]

#סעיף[א][הָיוּ לְפָנָיו מִינִים הַרְבֵּה, אִם בְּרָכוֹתֵיהֶם שָׁווֹת — מְבָרֵךְ עַל הֶחָבִיב לוֹ תְּחִלָּה. וְאִם אֵין בְּרָכוֹתֵיהֶם שָׁווֹת — מַקְדִּים הַמְבֹרָךְ ״בּוֹרֵא פְּרִי הָעֵץ״ לְשֶׁל ״בּוֹרֵא פְּרִי הָאֲדָמָה״#מדור_א[#ציון_מקור("ברכות", מקום: "מ׳ ע״ב"), ו#ציון_מקור("שולחן ערוך", מקום: "אורח חיים סימן רי״א").].]

#הזחה[
ובביאור טעם הדבר כתבו הראשונים שהפרי חשוב יותר מפרי האדמה, וכן ״שבעת המינים״ קודמים לשאר, שנאמר בהם שבח הארץ.
]

#פסוק[דברים ח׳, ח׳][אֶרֶץ חִטָּה וּשְׂעֹרָה וְגֶפֶן וּתְאֵנָה וְרִמּוֹן אֶרֶץ זֵית שֶׁמֶן וּדְבָשׁ].

#סעיף[ב][כָּל הַקָּרוֹב בַּפָּסוּק לְמִלַּת ״אֶרֶץ״ קוֹדֵם לַבְּרָכָה, וְלָכֵן זַיִת קוֹדֵם לִתְמָרִים, שֶׁהַזַּיִת שֵׁנִי לְ״אֶרֶץ״ וְהַתְּמָר חֲמִישִׁי#מדור_א[#ציון_מקור("ברכות", מקום: "מ״א ע״א"), ועיין ט״ז ומגן אברהם שם.].]

