#שער[קונטרס הלכות ברכות]
#תת_שער[בעניני ברכות הנהנין ודיניהן]

#קו_מפריד

#סימן[א׳][דין ברכה קודם הנאה]

#סעיף[א][אָסוּר לוֹ לָאָדָם שֶׁיֵּהָנֶה מִן הָעוֹלָם הַזֶּה בְּלֹא בְּרָכָה, וְכָל הַנֶּהֱנֶה בְּלֹא בְּרָכָה כְּאִלּוּ מָעַל בְּקָדְשֵׁי שָׁמַיִם#מראה_מקום[ברכות ל״ה ע״א, ורמב״ם הלכות ברכות פרק א׳ הלכה ב׳.].]

#סעיף[ב][צָרִיךְ לְבָרֵךְ קֹדֶם שֶׁיֵּהָנֶה סָמוּךְ לַהֲנָאָתוֹ מַמָּשׁ, וְלֹא יַפְסִיק בֵּין הַבְּרָכָה לָאֲכִילָה כְּדֵי דִּבּוּר#מראה_מקום[שולחן ערוך אורח חיים סימן קס״ז סעיף ו׳, ובמשנה ברורה ס״ק מ״ה.].]

#סעיף[ג][הַמְבָרֵךְ צָרִיךְ שֶׁיַּשְׁמִיעַ לְאָזְנוֹ מַה שֶּׁמּוֹצִיא בִּשְׂפָתָיו, וְאִם לֹא הִשְׁמִיעַ לְאָזְנוֹ יָצָא, וּבִלְבַד שֶׁיּוֹצִיא בִּשְׂפָתָיו#מראה_מקום[שולחן ערוך שם סימן ר״ו סעיף ג׳.].]

#סימן[ב׳][סדר קדימה בברכות]

#סעיף[א][הָיוּ לְפָנָיו מִינִים הַרְבֵּה, אִם בְּרָכוֹתֵיהֶם שָׁווֹת — מְבָרֵךְ עַל הֶחָבִיב לוֹ תְּחִלָּה. וְאִם אֵין בְּרָכוֹתֵיהֶם שָׁווֹת — מַקְדִּים הַמְבֹרָךְ ״בּוֹרֵא פְּרִי הָעֵץ״ לְשֶׁל ״בּוֹרֵא פְּרִי הָאֲדָמָה״#מראה_מקום[ברכות מ׳ ע״ב, ושו״ע או״ח סימן רי״א.].]

#הזחה[
ובביאור טעם הדבר כתבו הראשונים שהפרי חשוב יותר מפרי האדמה, וכן ״שבעת המינים״ קודמים לשאר, שנאמר בהם שבח הארץ.
]

#פסוק[דברים ח׳, ח׳][אֶרֶץ חִטָּה וּשְׂעֹרָה וְגֶפֶן וּתְאֵנָה וְרִמּוֹן אֶרֶץ זֵית שֶׁמֶן וּדְבָשׁ].

#סעיף[ב][כָּל הַקָּרוֹב בַּפָּסוּק לְמִלַּת ״אֶרֶץ״ קוֹדֵם לַבְּרָכָה, וְלָכֵן זַיִת קוֹדֵם לִתְמָרִים, שֶׁהַזַּיִת שֵׁנִי לְ״אֶרֶץ״ וְהַתְּמָר חֲמִישִׁי#מראה_מקום[ברכות מ״א ע״א, ועיין ט״ז ומג״א שם.].]

#קו_מפריד

#מקור[הועתק על פי שולחן ערוך אורח חיים חלק א׳, עם נושאי כליו.]
