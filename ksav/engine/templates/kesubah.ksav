#מרכז[#משמאל_לימין[ב"ה]]

#שער[כְּתֻבָּה]

#מרכז[#תת_שער[שטר תנאי הנישואין כדת משה וישראל]]

#קו_מפריד

#מרכז[
בְּ#חסר בְּשַׁבָּת, #חסר יוֹם לְחֹדֶשׁ #חסר שְׁנַת חֲמֵשֶׁת אֲלָפִים וּשְׁבַע מֵאוֹת וְ#חסר לִבְרִיאַת עוֹלָם, לְמִנְיָן שֶׁאָנוּ מוֹנִין כָּאן בְּעִיר #חסר אֲשֶׁר עַל נְהַר #חסר.
]

#מרווח(מידה: 0.5em)

אֵיךְ הֶחָתָן #הדגשה[#חסר בֶּן #חסר] אָמַר לָהּ לַהֲדָא בְּתוּלְתָּא #הדגשה[#חסר בַּת #חסר]: הֲוֵי לִי לְאִנְתּוּ כְּדַת מֹשֶׁה וְיִשְׂרָאֵל, וַאֲנָא אֶפְלַח וְאוֹקִיר וְאֵיזוּן וַאֲפַרְנֵס יָתִיכִי לִיכִי כְּהִלְכוֹת גֻּבְרִין יְהוּדָאִין דְּפָלְחִין וּמוֹקְרִין וְזָנִין וּמְפַרְנְסִין לִנְשֵׁיהוֹן בְּקוּשְׁטָא.

#הזחה[
וְיָהֵיבְנָא לִיכִי מֹהַר בְּתוּלַיְכִי כְּסַף זוּזֵי מָאתָן דְּחָזֵי לִיכִי מִדְּאוֹרַיְתָא, וּמְזוֹנַיְכִי וּכְסוּתַיְכִי וְסִפּוּקַיְכִי, וּמֵיעַל לְוָתִיכִי כְּאֹרַח כָּל אַרְעָא.
]

וּצְבִיאַת מָרַת #הדגשה[#חסר] בְּתוּלְתָּא דָא וַהֲוַת לֵיהּ לְאִנְתּוּ. וְדֵין נְדֻנְיָא דְּהַנְעֵלַת לֵיהּ, בֵּין בְּכֶסֶף בֵּין בְּזָהָב בֵּין בְּתַכְשִׁיטִין, הַכֹּל קִבֵּל עָלָיו הֶחָתָן הַנִּזְכָּר.

#כותרת3[קבלת אחריות]

וְכָךְ אָמַר הֶחָתָן: אַחֲרָיוּת שְׁטַר כְּתֻבָּתָא דָא קִבְּלִית עֲלַי וְעַל יָרְתַי בָּתְרַי, לְהִתְפְּרַע מִכָּל שְׁפַר אֲרַג נְכָסִין וְקִנְיָנִין דְּאִית לִי תְּחוֹת כָּל שְׁמַיָּא.

#הזחה[
וְלֹא כְּאַסְמַכְתָּא וְלֹא כְּטֹפְסֵי דִשְׁטָרֵי, אֶלָּא כְּחֹמֶר כָּל שִׁטְרֵי כְתֻבּוֹת הַנְּהוּגִין בִּבְנוֹת יִשְׂרָאֵל הָעֲשׂוּיִן כְּתִקּוּן חֲכָמֵינוּ זִכְרוֹנָם לִבְרָכָה.
]

#מרכז[
#הדגשה[וְהַכֹּל שָׁרִיר וְקַיָּם.]
]

