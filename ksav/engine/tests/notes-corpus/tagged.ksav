#let _EN = "KSAVEN"
#let en(body) = footnote[#metadata(_EN)#body]
#let isen(it) = repr(it.note.body).contains(_EN)
#show footnote.entry: it => {
  let n = counter(footnote).at(it.location()).first()
  set text(size: 8pt)
  if isen(it) { [#super[#numbering("א", n)]‡ #it.note.body] }
  else { [#super[#numbering("1", n)] #it.note.body] }
}
שורה1 טקסט הגוף של הספר#הערה[מקור מספר 1] וגם#en[ביאור מספר 1] וממשיך.

