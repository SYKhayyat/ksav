#מסמך(אזור_הערות: 5cm)[
#אזור("דף", מיקום: "רגל", פריסה: "צד", טורים: (1fr, 2fr), יחידה: "כותרת")
#ערוץ("רשי", אזור: "דף")
#ערוץ("תוספות", אזור: "דף")
#כותרת[סימן א]

גוף הספר בסימן הראשון#הערה_זרם("רשי")[רשי על סימן א] וכן#הערה_זרם("תוספות")[תוספות על סימן א] הלאה.

#כותרת[סימן ב]

גוף הספר בסימן השני#הערה_זרם("רשי")[רשי על סימן ב] וכן#הערה_זרם("תוספות")[תוספות על סימן ב] הלאה.
