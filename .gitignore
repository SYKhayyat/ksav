# Rust
target/

# The local override that points the shared `girsa-*` crates at a sibling
# `sefer-crates` checkout instead of the pinned commit. Ignored on purpose: it
# names a directory layout that exists on one machine, and committing it would
# put the fresh-clone build back where it was. `.cargo/config.toml.example` is
# tracked and says what to copy.
/.cargo/config.toml

# Node / front-end
node_modules/
build/
dist/
.vite/
coverage/

# Build + generated output
/ksav/out/
*.pdf

# Keep bundled font assets even though *.otf/*.ttf are binaries
!ksav/engine/assets/**

# WASM build artifacts
/ksav/wasm/pkg/

# Env / secrets
.env*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
.gstack/

# Generated wasm bindings (run: wasm-pack build; then copy to app/src/wasmpkg).
# The 29 MB module and its JS glue are build output and stay out of the repo —
# but the two .d.ts files are kept, because `wasm-worker.ts` imports from them
# and `tsc` typechecks every file under src/. Without them a clean clone could
# not typecheck or build at all, which is exactly how CI first broke: the
# artifacts existed on the machine that wrote the code and nowhere else.
/ksav/app/src/wasmpkg/*
!/ksav/app/src/wasmpkg/*.d.ts
/ksav/wasm/target/

# Lexicon build cache: the fetched corpora and the Ben-Yehuda word counts.
# Large and fully derivable — the built lexicon is what ships.
ksav/engine/tools/.corpus-cache/

# Front-end test scratch
/ksav/app/.tmp-test/
/ksav/app/.tmp-test-probe/

# Locally built Linux installers
/ksav/packaging/out/
